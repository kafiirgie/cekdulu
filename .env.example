# Salin jadi .env (di root repo). .env TIDAK di-commit.

# mock    = endpoint mengembalikan contract/examples (FE bisa mulai tanpa mesin)
# fixture = mesin aturan asli + data/fixtures (0 kredit)  ← default demo
# live    = mesin aturan asli + Sectors API (memakai kredit, ada batas di bawah)
CEKDULU_DATA_MODE=fixture

SECTORS_API_KEY=
# Batas kredit per proses server untuk mode live. Lindungi kuota saat juri mencoba.
SECTORS_CREDIT_BUDGET=100

# Gemini dipilih di C0. Gunakan none untuk fallback kata kunci (tanpa AI, tanpa OCR).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

CORS_ORIGINS=http://localhost:5173
